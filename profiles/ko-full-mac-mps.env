# ko-full on macOS + Apple Silicon: reranking is served by the host-native MPS sidecar
# (rerank-server/, launchd $HC_LAUNCHD_PREFIX.hindsight-rerank) instead of the in-container CPU
# cross-encoder. Measured 2026-07-26: 73 candidates / 37KB = 1.5-2.1s vs 55.8s on the
# container CPU path. Embeddings stay in-container (bge-m3, 1024-dim) - do NOT change
# them here, the dimension is locked at boot-0 and a change forces a full reindex.
#
# Requires on the host: rerank-server/ installed and the LaunchAgent loaded
#   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/$HC_LAUNCHD_PREFIX.hindsight-rerank.plist
#   (this line is right only in a shell that exported HC_LAUNCHD_PREFIX; the value lives in .env.host.local.
#   ./install writes it there, defaulting to the prefix in scripts/install/hc_install.py; a manual install
#   with scripts/render-launchd.py has no default and refuses with config_missing HC_LAUNCHD_PREFIX)
# Verify with: bash verify/gate8_rerank_provider.sh
HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-m3
HC_EMBED_DIM=1024
HINDSIGHT_API_RERANKER_PROVIDER=tei
HINDSIGHT_API_RERANKER_TEI_URL=http://host.lima.internal:8787
HINDSIGHT_API_RERANKER_TEI_HTTP_TIMEOUT=7.8
HINDSIGHT_API_RERANKER_TEI_MAX_CONCURRENT=1
# Unused while PROVIDER=tei. Kept as the rollback pin: switching back to
# provider=local must not fall through to an upstream default, and
# verify/gate8_rerank_provider.sh fails the local branch on an empty value.
HINDSIGHT_API_RERANKER_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
