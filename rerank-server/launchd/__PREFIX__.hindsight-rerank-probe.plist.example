<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__PREFIX__.hindsight-rerank-probe</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/rerank-server/probe.sh</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/hindsight-rerank/probe.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/hindsight-rerank/probe.log</string>
</dict>
</plist>
