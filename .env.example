# ── Hindsight-Crew configuration template ──────────────────────────────
# Copy to .env.local (gitignored) and fill. bootstrap auto-seeds secrets
# if .env.local is absent. NEVER commit real keys/tokens.

# Profile: cpu-en (v1 fully-verified) | ko-full (opt-in, unverified) | gpu (opt-in, unverified)
HC_PROFILE=cpu-en

# Pinned images by DIGEST (not tag) - currently upstream v1.1.0. Refresh deliberately.
# Pinning by @sha256 digest is RECOMMENDED for reproducible/non-demo use.
# The unattended demo (seed-demo.sh) and the compose fallback use the same v1.1.0 digest as below.
HC_HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight@sha256:50311d02b4d5d2b7c5242bd336edf8735df8374eaad496a92f49c83b37d2aa06

# Upstream Hindsight auth: single shared Bearer key. The GATEWAY holds this;
# MCP clients NEVER receive it. seed-demo.sh (run by bootstrap) replaces an empty, missing or
# placeholder value like the one below with a generated key, so a copied template never boots with it.
HC_HINDSIGHT_API_KEY=REPLACE_OR_AUTOSEED

# Gateway bind (host side). Hindsight 8888 stays on the internal docker net only.
HC_GATEWAY_BIND=127.0.0.1:8888

# pg0 data volume name. Unset = compose's automatic name (<project>_pg0, the pre-v1 volume).
# scripts/backup.sh backs up whichever volume this names. After the #249 cutover production must keep this key:
# removing it silently falls back to the compose default (<project>_pg0, the old volume) and backup.sh then backs
# up that volume too. Adding or changing it in .env.local changes the hindsight config hash (.env.local is the
# env_file of both services), so the next `up` recreates hindsight.
# HC_PG0_VOLUME=

# Backup retention (days). find -mtime based cleanup.
HC_BACKUP_RETENTION_DAYS=14

# ACL file: token -> {personal bank, team banks, identity}. Auto-seeded demo if absent.
HC_ACL_FILE=secrets/acl.json

# ── Model config (embeddings + reranker) ───────────────────────────────
# docker-compose.yml declares NO defaults for these: an environment: interpolation
# default outranks env_file and silently shadowed the reranker back to the CPU path
# (2026-07-26). .env.local is therefore the single source of truth, and these keys
# MUST be present. scripts/seed-demo.sh backfills any that are missing from the
# selected profile (profiles/<HC_PROFILE>.env), so copying this template is safe.
#
# The embedding model IS the vector dimension: changing it after boot-0 forces a
# full reindex. Keep it consistent with HC_EMBED_DIM and the chosen profile.
HINDSIGHT_API_LLM_PROVIDER=none
# LLM profile for ko-full (hindsight v1.0.0): claude-code/claude-sonnet-5-5, failover account1 then account2 on every slot.
# Keep "none" for CI/bootstrap. To move an older file: python3 scripts/llm-migrate-opus.py --env-file <file> [--apply].
# Target keys (verify/gate9_llm_fallback.sh judges them):
#   HINDSIGHT_API_LLM_PROVIDER=claude-code  HINDSIGHT_API_LLM_MODEL=claude-sonnet-5-5  HINDSIGHT_API_LLM_API_KEY=<account1 token>
#   HINDSIGHT_API_LLM_STRATEGY='{"mode":"failover"}'   (single quotes: a shell source and compose env_file read the same JSON)
#   HINDSIGHT_API_LLM_1_PROVIDER=claude-code  HINDSIGHT_API_LLM_1_MODEL=claude-sonnet-5-5  HINDSIGHT_API_LLM_1_API_KEY=<account2 token>
#   HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_STRATEGY='{"mode":"failover"}'  (+ _1_PROVIDER, _1_MODEL, _1_API_KEY = account2:
#   v1.0.0 gives the automatic refresh its own LLM that does not inherit the global chain)
# No other HINDSIGHT_API_<SLOT>_LLM_* keys, no HINDSIGHT_API_LLM_REASONING_EFFORT, nothing with XAI in its name.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5   # cpu-en; ko-full/gpu use BAAI/bge-m3
HC_EMBED_DIM=384                                              # 384 = bge-small-en-v1.5, 1024 = bge-m3
HINDSIGHT_API_RERANKER_PROVIDER=local                         # ko-full-mac-mps uses "tei" (host MPS sidecar)
# provider=tei: HINDSIGHT_API_RERANKER_MAX_RETRIES / _RETRY_BUDGET (v1.0.0 defaults 3 / 10s) do NOT apply to tei, which retries
# by itself (4 attempts, 0.5s doubling backoff, fixed in code). Leave them unset. Worst case = 4 x TEI_HTTP_TIMEOUT + 3.5s
# (34.7s at 7.8) - above the gateway's 30s upstream timeout; measured on the copy stack: 30.0s gateway 500, 34.9s upstream error.
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Gateway-only key (put it in .env.gateway.local, NOT here: .env.local is hindsight's env_file too). Value omitted on purpose.
# Needed only when HC_WEBHOOK_RECEIVER=1 (issue #303): the secret the upstream webhook is registered with.
# HC_WEBHOOK_SECRET=
